<!DOCTYPE gui SYSTEM "kpartgui.dtd">
<gui name="wildpalms" version="5">
    <MenuBar>
        <Menu name="file">
            <text>&amp;File</text>
            <Menu name="file_profile">
                <text>&amp;Profile</text>
                <Action name="file_new_profile"/>
                <Action name="file_switch_profile"/>
                <Action name="file_import_profile"/>
                <Action name="file_forget_profile"/>
                <Action name="file_close_profile"/>
                <Separator/>
                <Action name="file_profile_settings"/>
            </Menu>
            <Action name="file_configure_mappings"/>
            <Separator/>
            <Action name="file_quit"/>
        </Menu>

        <Menu name="device">
            <text>&amp;Device</text>
            <Action name="device_connect"/>
            <Action name="device_disconnect"/>
            <Action name="device_cancel_connection"/>
            <Separator/>
            <Action name="device_list_databases"/>
            <Action name="device_set_user_info"/>
            <Action name="device_info"/>
        </Menu>

        <Menu name="sync">
            <text>&amp;Sync</text>
            <Action name="sync_hotsync"/>
            <Action name="sync_fullsync"/>
            <Separator/>
            <Action name="sync_copy_palm_to_pc"/>
            <Action name="sync_copy_pc_to_palm"/>
            <Separator/>
            <Action name="sync_backup"/>
            <Action name="sync_restore"/>
            <Separator/>
            <Action name="sync_change_folder"/>
            <Action name="sync_open_folder"/>
            <Separator/>
            <Action name="sync_install_files"/>
        </Menu>

        <Menu name="view">
            <text>&amp;View</text>
            <Menu name="navigate">
                <text>&amp;Navigate</text>
                <Action name="view_page_dashboard"/>
                <Action name="view_page_memos"/>
                <Action name="view_page_contacts"/>
                <Action name="view_page_calendar"/>
                <Action name="view_page_tasks"/>
            </Menu>
            <Separator/>
            <Action name="view_toggle_log_panel"/>
            <Action name="view_focus_log"/>
            <Action name="view_clear_log"/>
            <Separator/>
            <Action name="view_show_conflicts"/>
        </Menu>

        <Menu name="settings">
            <text>&amp;Settings</text>
            <Action name="options_configure_toolbars"/>
            <Action name="options_configure_keybinding"/>
            <Separator/>
            <Action name="options_configure"/>
        </Menu>

        <Menu name="help">
            <text>&amp;Help</text>
        </Menu>
    </MenuBar>

    <ToolBar name="mainToolBar" noMerge="1">
        <text>Main Toolbar</text>
        <Action name="file_new_profile"/>
        <Separator/>
        <Action name="device_connect"/>
        <Action name="device_disconnect"/>
        <Separator/>
        <Action name="sync_hotsync"/>
        <Action name="sync_fullsync"/>
        <Separator/>
        <Action name="sync_backup"/>
        <Action name="sync_restore"/>
        <Separator/>
        <Action name="sync_install_files"/>
        <Action name="sync_open_folder"/>
    </ToolBar>

    <StatusBar/>
</gui>
